# syntax=docker/dockerfile:1
# Chainguard images are designed for supply-chain security:
# - minimal packages and fewer moving parts
# - patched daily through frequent rebuilds
# - strong provenance and SBOM story
# - many images target zero or near-zero known CVEs at release time
# - FIPS-ready variants are available for stricter compliance environments
# - suitable for organisations that care about hardened defaults and compliance

# Use the -dev variant for the build stage because it includes the tooling needed to
# install dependencies and compile TypeScript. The pure runtime image is even smaller.
FROM cgr.dev/chainguard/node:latest-dev AS build

WORKDIR /app

# --- Corporate CA trust (e.g. Netskope TLS interception) ---------------------
# Default EXTRA_CERTS_DIR=certs points at an empty placeholder, so this is a NO-OP
# on a normal laptop and only activates when real .crt files are supplied in certs/.
# Pass real certs with:  docker build --build-arg EXTRA_CERTS_DIR=certs ...
ARG EXTRA_CERTS_DIR=certs
COPY ${EXTRA_CERTS_DIR}/ /usr/local/share/ca-certificates/extra/
RUN if ls -A /usr/local/share/ca-certificates/extra/ 2>/dev/null | grep -q .; then \
        if command -v update-ca-certificates >/dev/null 2>&1; then \
            update-ca-certificates; \
        else \
            cat /usr/local/share/ca-certificates/extra/*.crt >> /etc/ssl/certs/ca-certificates.crt; \
        fi; \
    fi
# -----------------------------------------------------------------------------

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

RUN npm run build && npm prune --omit=dev

# Runtime stage: the non-dev Chainguard image keeps the footprint small and aligns
# with the talk's message around hardened, minimal, fast-patched base images.
FROM cgr.dev/chainguard/node:latest

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

# Chainguard runtime images are intentionally shell-less/minimal, so the runtime
# stage cannot run update-ca-certificates; copy the refreshed bundle from build.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json

# Chainguard images run as a non-root user by default, which is one of the simplest
# and highest-impact container hardening steps.
USER nonroot

EXPOSE 8080
CMD ["dist/index.js"]

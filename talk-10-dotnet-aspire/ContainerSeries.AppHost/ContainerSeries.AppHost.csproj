<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="9.0.0" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.0.0" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="9.0.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="9.0.0" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContainerSeries.Api\ContainerSeries.Api.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ContainerSeries.NotificationService\ContainerSeries.NotificationService.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ContainerSeries.OrderService\ContainerSeries.OrderService.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\ContainerSeries.Web\ContainerSeries.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
